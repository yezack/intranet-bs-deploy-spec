# <项目名> 环境变量模板
# 用法：cp .env.example .env  →  填写  →  chmod 600 .env
#
# 【强制】本文件不含真实口令；.env 严禁提交版本库、严禁打进镜像（规范 S5）
# 【强制】所有可变配置只在本文件；docker-compose.yml 以 ${VAR} 引用（规范 §3.3）

# ---------- 项目标识 ----------
# 必须与目录名 / 容器名前缀 / 镜像名前缀一致（规范关键词约定）
# 只允许小写字母、数字、连字符
# 【示例值】myapp 必须整体替换为你的 <项目名>
PROJECT_NAME=myapp

# ---------- 对外域名（开发启动前必须确认）----------
# 【强制】由运维分配的访问域名，**开发动工前**就要确认并填在这里，不得自行编造。
# 必须与 deploy/gateway-site.conf 的 server_name 逐字一致，否则网关匹配不到该域名。
# tools/preflight.sh 会校验这两处是否一致：未确认或不一致 → 禁止打包交付。
# 例：xz.sjq.sh（单位内网域名）；若单位暂无域名规划，可用 <项目名>.lan。
# 现场测试机上通常用 /etc/hosts 把该域名指向本机 IP 做单机模拟验证。
SITE_DOMAIN=CHANGE_ME_DOMAIN

# ---------- 统一网关（容器名，仅用于打印命令）----------
# 【强制】判定「网关是否存在」**不依赖这两个键**：脚本按「谁发布了宿主 :80 且它在 gateway-network 上」
# 自动探测，与容器名无关。它们只用于 ① 打印给运维的命令；② 现场确实用宿主级反代时的显式确认。
# GATEWAY_CONTAINER：探测不到时的兜底名（基准环境 nginx-gateway；现场可能是 gateway-nginx）。
# GATEWAY_PROCESS  ：若宿主 :80 由**宿主级** nginx/apache 监听（不在 Docker 网络里），必须写明进程名。
GATEWAY_CONTAINER=nginx-gateway
GATEWAY_PROCESS=

# ---------- 运行时固定项 ----------
TZ=Asia/Shanghai

# ---------- 容器运行身份 ----------
# 【强制】容器内进程的 uid:gid，必须与宿主 conf/ uploads/ downloads/ 的属主一致
# （规范 §3.4 / §4.5）。默认 1000 = 镜像内 app 用户；仅当宿主 uid 冲突时才调整。
# 注意：改成非 1000 时容器内没有对应的 passwd 条目，个别依赖 getpwuid 的库会有告警。
APP_UID=1000
APP_GID=1000

# ========== 数据库 ==========
# 【关键】一处开关决定连哪个库，代码一行不动（连接串在 app/db.py 按本开关构造，规范 §3.3/§3.6）
#
#   本地开发 → 把这行改成 sqlite（零依赖，开箱即跑，见下方"本地开发"段）
#   内网部署 → 保持 mariadb 或改为 pgsql（见下方"内网部署"段）
#
# 默认给 mariadb 而非 sqlite，是为了让"交付包原样复制到内网"这一步天然安全：
# sqlite 在容器里会随容器消亡（镜像层只读且无持久卷，违反 S2），
# 因此 init.sh / update.sh 会直接拒绝 DB_ENGINE=sqlite，tools/verify.sh 判 FAIL。
# 本地开发要切 sqlite，执行这一行即可：
#   sed -i 's/^DB_ENGINE=.*/DB_ENGINE=sqlite/' .env
DB_ENGINE=mariadb

# ---------- 本地开发：SQLite（仅 DB_ENGINE=sqlite 时生效）----------
# 库里没有真实用户数据，随删随建。父目录不存在时 app/db.py 会自动创建。
# 【强制】本目录必须进 .gitignore，且 DB_SQLITE_PATH 只允许出现在本地 .env 中。
DB_SQLITE_PATH=.local/dev.db

# ---------- 内网部署：共享数据库（仅 DB_ENGINE=mariadb|pgsql 时生效）----------
# 基础服务由运维在 gateway-network 内提供，项目只连接、不自建容器（规范 §3.3）。
# DB_HOST 即运维提供的容器名，下面四项由运维下发，须与 deploy/init-db.*.sql 逐字一致：
#   MariaDB    → DB_HOST=mariadb   DB_PORT=3306
#   PostgreSQL → DB_HOST=pgsql     DB_PORT=5432   （pgsql 待运维部署）
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=myapp_db
DB_USERNAME=myapp_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# 【强制】连接池上限：多个项目共用同一个 mariadb，
# 各项目池上限之和必须 ≤ 运维设定的 max_connections（新增项目前先确认余量，规范 §3.3）
DB_POOL_SIZE=5

# ---------- 应用安全 ----------
# 至少 32 字符随机串。现场可以留空或保持占位值：init.sh 会检测到并自动生成后写回 .env。
# 需要手工生成时：openssl rand -hex 32
SECRET_KEY=CHANGE_ME_32_BYTES_RANDOM_STRING

# ---------- 初始管理员（项目自定义键，按需增删）----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ---------- 回滚告警（可选）----------
# update.sh 回滚时 POST 该地址；留空则只打印告警（规范 §5.2）
ALERT_WEBHOOK=

# ---------- 说明 ----------
# 1) 项目自定义变量一律用大写加下划线，并同步补进本模板
# 2) 注释一律单独成行，不要写行内注释：`#` 前没有空格时（如 VAR=value#注释），
#    部分解析器会把 `#注释` 并入变量值，改口令后出现的诡异故障多源于此。
